VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key

# Web3Forms (https://web3forms.com)
# One free access key per form, all under shawarmaalleyfranchise@gmail.com, so
# submissions stay organized per-form in the Web3Forms dashboard. The keys are
# baked into src/services/emailService.js as defaults; set these only to override.
# VITE_WEB3FORMS_ACCESS_KEY_FRANCHISE=your_franchise_access_key
# VITE_WEB3FORMS_ACCESS_KEY_CATERING=your_catering_access_key
# VITE_WEB3FORMS_ACCESS_KEY_FEEDBACK=your_feedback_access_key
#
# Free tier delivers staff notification emails with a custom subject, from_name,
# reply-to (set to the customer's email so you can reply directly), and honeypot
# spam protection. Guest auto-reply confirmations and CC/BCC copies require
# Web3Forms PRO (configure the autoresponder in their dashboard).
